# A node's agent settings, /etc/opence-fleet/agent.env (mode 0600: it holds
# the node token). agent.sh writes it at the enrolment; every option:
# README.md, "Options". The port ranges, the public address, the limits and
# the loopback base are node settings on the fleet's Nodes page, not here.

FLEET_AGENT_URL=https://fleet.example.org
# the node token: made by the enrolment (`opence-fleet agent --join <url>
# --token <join token>`), never the join token itself
FLEET_AGENT_TOKEN=
FLEET_AGENT_DIR=/var/lib/opence-fleet
#FLEET_AGENT_NAME=eu-1
# docker (each server a container of the server image) or process (the
# release's halo --server as child processes)
#FLEET_AGENT_RUNTIME=docker
#FLEET_AGENT_DOCKER_HOST=unix:///var/run/docker.sock
# an existing game data folder (maps/, custom_maps/, gametypes/) instead of
# the library the control plane syncs
#FLEET_AGENT_DATA_ROOT=/srv/halo
#FLEET_AGENT_LOG_LEVEL=info
