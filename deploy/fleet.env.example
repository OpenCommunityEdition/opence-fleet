# The control plane's settings (every option: README.md, "Options"; each is
# also a flag of `opence-fleet serve`). The fleet's name, time zone,
# retention and webhooks are set on its Settings page; a variable set here
# wins over the page and shows there as pinned.

# the fleet's public HTTPS origin: the agents' one-liner and the links
FLEET_PUBLIC_URL=https://fleet.example.org

#FLEET_NAME=My fleet
#FLEET_TIMEZONE=Europe/Paris
# the server image (or a mirror of it), and the game's repository whose
# releases' zips the process runtime runs
#FLEET_IMAGE=ghcr.io/opencommunityedition/opence-server
#FLEET_RELEASE_REPOSITORY=OpenCommunityEdition/OpenCE
# a masters.txt naming the masters the Masters page asks (the official one by default)
#FLEET_MASTERS_FILE=/data/masters.txt
# notify (a button for the owners), auto, or off
#FLEET_UPDATES=notify
# a public, read-only /status page of the servers
#FLEET_PUBLIC_STATUS=false
#FLEET_EVENTS_DAYS=30
#FLEET_SAMPLES_DAYS=7
#FLEET_LOG_LEVEL=info
# how long a sign-in lasts, and how long unused (an open page keeps it
# used; 0: no idle limit)
#FLEET_SESSION_HOURS=12
#FLEET_SESSION_IDLE_MINUTES=240
