package pages

import (
	"strings"

	"github.com/OpenCommunityEdition/opence-fleet/internal/serverapi"
	"github.com/OpenCommunityEdition/opence-fleet/internal/store/db"
	"github.com/OpenCommunityEdition/opence-fleet/internal/view"
	"github.com/OpenCommunityEdition/opence-fleet/internal/view/parts"
)

// FleetPlayer is a player on one of the fleet's servers.
type FleetPlayer struct {
	serverapi.Player
	Slug, Server string
}

// Players is everyone online across the fleet.
templ Players(p view.Page, players []FleetPlayer, search string, problems []string) {
	@parts.Shell(p) {
		@parts.Head("Players", "Everyone on the fleet's servers now.")
		@parts.Body() {
			<form method="get" action="/players" class="flex gap-2">
				<input name="q" value={ search } class={ view.Input + " max-w-sm" } placeholder="Search a name, an address"/>
				<button type="submit" class={ view.Secondary }>
					@parts.Icon("search", "size-4")
					Search
				</button>
			</form>
			@PlayersFleetTable(p, players, search, problems)
		}
	}
}

// PlayersFleetTable is the fleet's players (refreshed every 5 s).
templ PlayersFleetTable(p view.Page, players []FleetPlayer, search string, problems []string) {
	<div id="fleet-players" hx-get={ "/players/fragment?q=" + search } hx-trigger="every 5s" hx-swap="outerHTML" class={ view.Panel + " overflow-x-auto" }>
		if len(players) == 0 {
			<p class="px-4 py-8 text-center text-sm text-muted">
				if search != "" {
					Nobody online matches.
				} else {
					Nobody plays on the fleet now.
				}
			</p>
		} else {
			<table class="w-full text-sm">
				<thead>
					<tr>
						<th class={ view.Th }>Name</th><th class={ view.Th }>Server</th><th class={ view.Th }>Team</th>
						<th class={ view.Th + " text-right" }>Score</th><th class={ view.Th + " text-right" }>Ping</th>
						<th class={ view.Th }>Played</th>
						<th class={ view.Th }>Client</th>
						if p.Can("admin") {
							<th class={ view.Th }>Address · hardware id</th>
						}
						<th class={ view.Th }></th>
					</tr>
				</thead>
				<tbody>
					for _, pl := range players {
						<tr class={ view.Tr }>
							<td class={ view.Td + " font-medium" }>{ pl.Name }</td>
							<td class={ view.Td }><a class="hover:text-accent" href={ templ.SafeURL("/servers/" + pl.Slug + "/players") }>{ pl.Server }</a></td>
							<td class={ view.Td + " text-muted" }>{ teamName(pl.Team) }</td>
							<td class={ view.Td + " text-right tabular-nums" }>{ view.Itoa(pl.Score) }</td>
							<td class={ view.Td + " text-right tabular-nums text-muted" }>
								if pl.Ping != nil {
									{ view.Itoa(*pl.Ping) }
								}
							</td>
							<td class={ view.Td + " text-muted" }>{ view.Uptime(timeOf(pl.Joined*1000), p.Now) }</td>
							<td class={ view.Td }>@ClientCell(p, pl.Client)</td>
							if p.Can("admin") {
								<td class={ view.Td + " text-xs text-muted" }>{ pl.Address } <span class="text-faint">{ view.Short(pl.HWID, 12) }</span></td>
							}
							<td class={ view.Td + " text-right" }>
								if p.Can("moderator") {
									@PlayerActions(p, pl.Slug, pl.Player)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		for _, problem := range problems {
			<p class="border-t border-line px-4 py-2 text-xs text-faint">{ problem }</p>
		}
	</div>
}

// BanLine is a fleet ban with where it holds.
type BanLine struct {
	db.FleetBan
	Held, Pending, Failed int
}

// Bans is the fleet's ban list.
templ Bans(p view.Page, bans []BanLine, all bool) {
	@parts.Shell(p) {
		@parts.Head("Bans", "The fleet's bans: each holds on every server (the server's own ban, or a line of its bans.txt).") {
			if all {
				<a href="/bans" class={ view.Secondary }>Active only</a>
			} else {
				<a href="/bans?all=1" class={ view.Secondary }>With the ended ones</a>
			}
		}
		@parts.Body() {
			<div class={ view.Panel + " overflow-x-auto" }>
				if len(bans) == 0 {
					<p class="px-4 py-8 text-center text-sm text-muted">No ban. A ban from a player's row is a fleet ban; so is one made on a server's own console, which the fleet imports.</p>
				} else {
					<table class="w-full text-sm">
						<thead><tr><th class={ view.Th }>#</th><th class={ view.Th }>Names</th><th class={ view.Th }>Address · hardware id</th><th class={ view.Th }>Reason</th><th class={ view.Th }>Until</th><th class={ view.Th }>By</th><th class={ view.Th }>Holds</th><th class={ view.Th }></th></tr></thead>
						<tbody>
							for _, b := range bans {
								<tr class={ view.Tr, templ.KV("opacity-50", b.RemovedAt != nil) }>
									<td class={ view.Td + " text-muted tabular-nums" }>{ view.I64(b.ID) }</td>
									<td class={ view.Td + " font-medium" }>{ firstOf(b.Names, "—") }</td>
									<td class={ view.Td + " text-xs text-muted" }>{ b.Address } <span class="text-faint">{ view.Short(b.Hwid, 12) }</span></td>
									<td class={ view.Td }>{ b.Reason }</td>
									<td class={ view.Td + " whitespace-nowrap text-muted" }>
										if b.Until == nil {
											{ "for ever" }
										} else {
											{ view.UnixPtr(b.Until, p.Zone) }
										}
									</td>
									<td class={ view.Td + " text-muted" }>{ b.CreatedBy }</td>
									<td class={ view.Td + " text-xs" }>
										<span class="text-ok">{ view.Itoa(b.Held) } held</span>
										if b.Pending > 0 {
											· <span class="text-warn">{ view.Itoa(b.Pending) } waiting</span>
										}
										if b.Failed > 0 {
											· <span class="text-bad">{ view.Itoa(b.Failed) } failed</span>
										}
									</td>
									<td class={ view.Td + " text-right" }>
										if p.Can("admin") && b.RemovedAt == nil {
											@parts.Post("/bans/"+view.I64(b.ID)+"/delete", "Unban", view.Secondary+view.Small, p.CSRF)
										}
										if b.RemovedAt != nil {
											<span class="text-xs text-faint">unbanned by { b.RemovedBy }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			if p.Can("admin") {
				<div class="grid gap-4 lg:grid-cols-2">
					@parts.Card("Ban by hand", "An address or a hardware id, kept off every server.") {
						@parts.Pad() {
							<form method="post" action="/bans" class="grid gap-3 sm:grid-cols-2">
								@parts.CSRF(p.CSRF)
								<input name="address" class={ view.Input } placeholder="203.0.113.5"/>
								<input name="hwid" class={ view.Input } placeholder="a hardware id"/>
								<input name="names" class={ view.Input } placeholder="the names seen"/>
								<select name="duration" class={ view.Select }>
									<option value="">{ "for ever" }</option>
									<option value="24h">1 day</option>
									<option value="168h">1 week</option>
									<option value="720h">30 days</option>
								</select>
								<input name="reason" class={ view.Input + " sm:col-span-2" } placeholder="The reason"/>
								<div class="sm:col-span-2"><button type="submit" class={ view.Primary }>Ban</button></div>
							</form>
						}
					}
					@parts.Card("Import a bans.txt", "Each line's address and hardware id become fleet bans.") {
						@parts.Pad() {
							<form method="post" action="/bans/import" class="space-y-3">
								@parts.CSRF(p.CSRF)
								<textarea name="text" rows="5" class={ view.TextArea } placeholder="2026-10-19 18:00:00	ip=203.0.113.5	hwid=…	players=…	reason=…" required></textarea>
								<button type="submit" class={ view.Secondary }>Import</button>
							</form>
						}
					}
				</div>
			}
		}
	}
}

// ClientCell is a player's game as it told the server: its build, a badge
// for a game made from another repository than the fleet's (a fork) and one
// for its mods; its label, repository and mods on hover.
templ ClientCell(p view.Page, c *serverapi.ClientBuild) {
	if c == nil {
		<span class="text-faint" title="Its game does not tell its build (an older one)">—</span>
	} else {
		<span class="inline-flex flex-wrap items-center gap-1 whitespace-nowrap" title={ clientTitle(c) }>
			<span class="tabular-nums">{ clientBuildLabel(c) }</span>
			if c.Repository != "" && p.Repository != "" && !strings.EqualFold(c.Repository, p.Repository) {
				@parts.Badge(view.Warn, "fork")
			}
			if len(c.Mods) > 0 {
				@parts.Badge(view.Info, view.Count(len(c.Mods), "mod", "mods"))
			}
		</span>
	}
}
