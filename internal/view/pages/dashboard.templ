package pages

import (
	"github.com/OpenCommunityEdition/opence-fleet/internal/view"
	"github.com/OpenCommunityEdition/opence-fleet/internal/view/parts"
)

// Tiles is the dashboard's numbers (a live fragment: tiles).
type Tiles struct {
	Up, Total, Players, Nodes, NodesOnline, Alerts int
	Blocked                                       []string
	Peak                                          string
	Spark                                         string
	NodeNames                                     string
	FirstAlert                                    string
}

// NodeGroup is a node's servers on the dashboard.
type NodeGroup struct {
	Name, Line string
	Online     bool
	Rows       []view.ServerRow
}

// AlertLine is an open alert.
type AlertLine struct {
	ID                   int64
	Rule, Target, Detail string
	Since                string
	Told                 string
	Tone                 view.Tone
}

// Dashboard is the fleet at a glance.
templ Dashboard(p view.Page, tiles Tiles, groups []NodeGroup, alerts []AlertLine, feed []view.FeedLine, releaseBanner string) {
	@parts.Shell(p) {
		<header class="flex flex-wrap items-center gap-3 border-b border-line px-4 py-4 lg:px-6">
			<h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
			<span class={ view.Badge(view.OK) } title="the page follows the fleet live">
				<span class={ view.Dot(view.OK) + " pulse" }></span> live
			</span>
			<div class="ml-auto flex flex-wrap items-center gap-2">
				if releaseBanner != "" {
					<a href="/releases" class={ view.Badge(view.Info) }>{ releaseBanner }</a>
				}
				if p.Can("moderator") && tiles.Total > 0 {
					@SayToAll(p)
				}
				if p.Can("admin") {
					<a href="/servers/new" class={ view.Primary }>
						@parts.Icon("plus", "size-4")
						New servers
					</a>
				}
			</div>
		</header>
		@TilesView(tiles)
		<section class="grid gap-4 px-4 pb-6 lg:px-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
			<div class="min-w-0 space-y-4">
				if len(groups) == 0 {
					@parts.Card("", "") {
						@parts.Empty("No servers yet. A node runs them: add one, then a profile and servers from it.") {
							if p.Can("admin") {
								<a href="/nodes/add" class={ view.Secondary }>Add a node</a>
								<a href="/servers/new" class={ view.Primary }>New servers</a>
							}
						}
					}
				}
				for _, g := range groups {
					<div class="rounded-lg border border-line bg-panel" id={ "node-" + g.Name }>
						<div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
							<h2 class="text-base font-semibold">{ g.Name }</h2>
							if g.Online {
								@parts.State("online", view.OK)
							} else {
								@parts.State("offline", view.Bad)
							}
							<span class="text-xs text-faint">{ g.Line }</span>
							if g.Name != "" {
								<a class="ml-auto text-xs text-accent" href={ templ.SafeURL("/nodes/" + g.Name) }>node ›</a>
							}
						</div>
						@parts.RowHeader(false)
						for _, r := range g.Rows {
							@parts.Row(r, false, p.CSRF)
						}
					</div>
				}
			</div>
			<div class="space-y-4">
				@AlertsCard(alerts, p)
				<div class="rounded-lg border border-line bg-panel p-5">
					<h2 class="text-base font-semibold">Feed</h2>
					@parts.Feed(feed, "feed", "Nothing yet: the servers' joins, games and moderation show here as they happen.")
				</div>
			</div>
		</section>
	}
}

// SayToAll is the dashboard's notice to every server.
templ SayToAll(p view.Page) {
	<details class="relative">
		<summary class={ view.Secondary + " list-none [&::-webkit-details-marker]:hidden" }>
			@parts.Icon("megaphone", "size-4")
			Say to all
		</summary>
		<form method="post" action="/servers/bulk" class="absolute right-0 z-30 mt-2 w-80 space-y-3 rounded-lg border border-line-strong bg-panel p-4 shadow-2xl shadow-black/50 max-sm:fixed max-sm:inset-x-3 max-sm:w-auto">
			@parts.CSRF(p.CSRF)
			<input type="hidden" name="action" value="say"/>
			<input type="hidden" name="all" value="1"/>
			<input type="hidden" name="back" value="/"/>
			<label class={ view.Label } for="say-all">A notice on every server's screen</label>
			<input id="say-all" name="text" class={ view.Input } maxlength="200" required placeholder="Restart at 04:00"/>
			<div class="flex justify-end"><button type="submit" class={ view.Primary }>Say</button></div>
		</form>
	</details>
}

// TilesView is the dashboard's tiles (the live fragment).
templ TilesView(t Tiles) {
	<section id="tiles" sse-swap="tiles" hx-swap="outerHTML" class="grid grid-cols-2 gap-4 px-4 pt-6 pb-4 lg:px-6 xl:grid-cols-4">
		{{ blocked := "" }}
		if len(t.Blocked) > 0 {
			{{ blocked = view.Count(len(t.Blocked), "blocked: ", "blocked: ") + view.Join(t.Blocked, ", ") }}
		}
		if blocked != "" {
			@parts.Tile("Servers up", view.Itoa(t.Up), " / "+view.Itoa(t.Total), blocked, view.Bad)
		} else {
			@parts.Tile("Servers up", view.Itoa(t.Up), " / "+view.Itoa(t.Total), "of the fleet's servers", view.Neutral)
		}
		@parts.SparkTile("Players now", view.Itoa(t.Players), t.Peak, t.Spark)
		@parts.Tile("Nodes", view.Itoa(t.NodesOnline), " / "+view.Itoa(t.Nodes), t.NodeNames, view.Neutral)
		if t.Alerts > 0 {
			@parts.Tile("Alerts", view.Itoa(t.Alerts), "", t.FirstAlert, view.Bad)
		} else {
			@parts.Tile("Alerts", "0", "", "all quiet", view.Neutral)
		}
	</section>
}

// AlertsCard is the open alerts.
templ AlertsCard(alerts []AlertLine, p view.Page) {
	<div id="alerts-card" sse-swap="alerts" hx-swap="outerHTML" class="rounded-lg border border-line bg-panel p-5">
		<div class="flex items-center">
			<h2 class="text-base font-semibold">Alerts</h2>
			<a href="/alerts" class="ml-auto text-xs text-accent">all ›</a>
		</div>
		if len(alerts) == 0 {
			<p class="mt-3 text-sm text-faint">No open alert.</p>
		}
		for _, a := range alerts {
			<div class="mt-3 rounded-md border border-bad/30 bg-bad/5 p-3 text-sm">
				<div class="flex items-center gap-2 font-medium text-bad">
					<span class={ view.Dot(view.Bad) }></span>
					{ a.Target }: { a.Rule }
				</div>
				<p class="mt-1 line-clamp-3 text-muted">{ a.Detail }</p>
				<div class="mt-2 text-xs text-faint">
					since { a.Since }
					if a.Told != "" {
						· told { a.Told }
					}
				</div>
			</div>
		}
	</div>
}
